import OMAReductions.R_Green14_W_3_14_R2

/-!
# The palindromic van der Waerden breakpoints for (3, 14)

Ahmed, Kullmann and Snevily, *On the van der Waerden numbers w(2; 3, t)*,
Discrete Applied Mathematics 174 (2014), §5.2, Table 6, give (174, 183).
The 173- and 182-position witnesses and the exhaustion trees for 175 and
184 positions give the exact spectrum by removing symmetric endpoints.

The checker follows KoaOkano's formalization for (3, 13). A postfix
encoding keeps both trees together in a single submission. Every forced
color and every final conflict is checked against an arithmetic progression.
-/

-- Formalization: @KoaOkano

namespace PalindromicThreeFourteen


-- A rule requires one of the positions in its mask to have its specified color.
structure Rule where
  color : Bool
  mask : Nat
  deriving Inhabited

abbrev Board := Bool → Nat

def agrees (c : Nat → Bool) (s : Board) := ∀ b i, (s b).testBit i = true → c i = b

def marked (s : Board) (b : Bool) (i : Nat) : Board :=
  fun v => if v = b then s b ||| 2^i else s v

theorem agrees_marked {c s b i} (h : agrees c s) (hi : c i = b) :
    agrees c (marked s b i) := by
  intro v j hj
  by_cases he : v = b
  · subst v
    have upd : marked s b i b = s b ||| 2^i := by simp [marked]
    rw [upd, Nat.testBit_or, Nat.testBit_two_pow, Bool.or_eq_true] at hj
    rcases hj with hj | hj
    · exact h b j hj
    · simpa [of_decide_eq_true hj] using hi
  · exact h v j (by simpa [marked, he] using hj)

def live (r : Rule) (s : Board) := r.mask ^^^ (r.mask &&& s (!r.color))

def hits (c : Nat → Bool) (r : Rule) := ∃ i, r.mask.testBit i = true ∧ c i = r.color

theorem has_live {c s r} (hs : agrees c s) (hr : hits c r) :
    ∃ i, (live r s).testBit i = true ∧ c i = r.color := by
  obtain ⟨i, hm, hc⟩ := hr
  have hb : (s (!r.color)).testBit i = false := by
    cases e : (s (!r.color)).testBit i with
    | false => rfl
    | true =>
      have eq := (hs (!r.color) i e).symm.trans hc
      cases ec : r.color <;> simp [ec] at eq
  exact ⟨i, by simp [live, Nat.testBit_xor, hm, hb], hc⟩

-- Unit instructions in a chain are little-endian digits in base 8192.
def propagate (rule : Nat → Rule) : Nat → Nat → Board → Option Board
  | 0, _, s => some s
  | k+1, digits, s =>
    let r := rule (digits % 8192)
    let candidate := live r s
    let i := candidate.log2
    if candidate = 2^i then
      propagate rule k (digits / 8192) (marked s r.color i)
    else none

theorem propagate_sound {c : Nat → Bool} {rule : Nat → Rule} (hr : ∀ i, hits c (rule i))
    (k digits : Nat) (s t : Board) (hs : agrees c s)
    (pass : propagate rule k digits s = some t) : agrees c t := by
  induction k generalizing digits s with
  | zero =>
    simp only [propagate, Option.some.injEq] at pass
    simpa only [← pass] using hs
  | succ k ih =>
    simp only [propagate] at pass
    split at pass
    · rename_i eq
      obtain ⟨j, hj, hc⟩ := has_live hs (hr (digits % 8192))
      rw [eq, Nat.testBit_two_pow] at hj
      have ij := of_decide_eq_true hj
      exact ih _ _ (agrees_marked hs (ij ▸ hc)) pass
    · contradiction

inductive Tree where
  | stop (count digits conflict : Nat)
  | fork (count digits site : Nat) (red blue : Tree)

def check (rule : Nat → Rule) : Tree → Board → Bool
  | .stop k digits j, s =>
    match propagate rule k digits s with
    | none => false
    | some t => live (rule j) t == 0
  | .fork k digits i l r, s =>
    match propagate rule k digits s with
    | none => false
    | some t => check rule l (marked t true i) && check rule r (marked t false i)

theorem check_sound {c : Nat → Bool} {rule : Nat → Rule} (hr : ∀ i, hits c (rule i))
    (tree : Tree) (s : Board) (hs : agrees c s) (pass : check rule tree s = true) : False := by
  induction tree generalizing s with
  | stop k digits j =>
    cases e : propagate rule k digits s with
    | none => simp [check, e] at pass
    | some t =>
      have hz : live (rule j) t = 0 := by simpa [check, e] using pass
      obtain ⟨i, hi, _⟩ := has_live (propagate_sound hr k digits s t hs e) (hr j)
      simp [hz] at hi
  | fork k digits i l r il ir =>
    cases e : propagate rule k digits s with
    | none => simp [check, e] at pass
    | some t =>
      obtain ⟨hl, hb⟩ := Bool.and_eq_true_iff.mp (by simpa only [check, e] using pass)
      have ht := propagate_sound hr k digits s t hs e
      cases hc : c i with
      | false => exact ir _ (agrees_marked ht hc) hb
      | true => exact il _ (agrees_marked ht hc) hl

def pointMask (n a d : Nat) : Nat → Nat
  | 0 => 0
  | l+1 => pointMask n a d l ||| 2^(min (a+l*d) (n-1-(a+l*d)))

theorem pointMask_bit (n a d l t : Nat) (ht : t < l) :
    (pointMask n a d l).testBit (min (a+t*d) (n-1-(a+t*d))) = true := by
  induction l with
  | zero => omega
  | succ l ih =>
    rw [pointMask, Nat.testBit_or, Bool.or_eq_true]
    by_cases e : t = l
    · subst t
      right
      simp
    · exact Or.inl (ih (by omega))

def terms (k : Nat) (b : Bool) := if b then k else 3

def Avoid (n k : Nat) (c : Nat → Bool) :=
  ∀ b a d, 0 < d → a + (terms k b - 1) * d < n →
    ∃ t < terms k b, c (a + t*d) = b

def Pal (n : Nat) (c : Nat → Bool) := ∀ x < n, c (n - 1 - x) = c x

def Good (n k : Nat) := ∃ c, Pal n c ∧ Avoid n k c

private def fromAP (n k : Nat) (b : Bool) (a d : Nat) : Rule :=
  ⟨b, pointMask n a d (terms k b)⟩

-- Each instruction names a progression by its color, common difference and start.
-- Invalid codes name the first three positions, so every code has a sound rule.
def apRule (n k code : Nat) : Rule :=
  let b := decide (4300 ≤ code)
  let z := code % 4300
  let layer := ((8*z+1).sqrt-1)/2
  let a := z - layer*(layer+1)/2
  let d := layer-a+1
  if a + (terms k b - 1) * d < n then fromAP n k b a d else fromAP n k false 0 1

theorem fromAP_hits {n k c} (hp : Pal n c) (ha : Avoid n k c) (b a d)
    (hd : 0 < d) (he : a + (terms k b - 1) * d < n) : hits c (fromAP n k b a d) := by
  obtain ⟨t, ht, hc⟩ := ha b a d hd he
  have hx : a+t*d < n :=
    lt_of_le_of_lt (Nat.add_le_add_left (Nat.mul_le_mul_right d (show t ≤ terms k b - 1 by omega)) a) he
  refine ⟨min (a+t*d) (n-1-(a+t*d)), pointMask_bit _ _ _ _ _ ht, ?_⟩
  rcases le_total (a+t*d) (n-1-(a+t*d)) with h | h
  · simpa only [min_eq_left h, fromAP] using hc
  · simpa only [min_eq_right h, hp _ hx, fromAP] using hc

theorem apRule_hits {n k c} (hn : 3 ≤ n) (hp : Pal n c) (ha : Avoid n k c)
    (i : Nat) : hits c (apRule n k i) := by
  simp only [apRule]
  split
  · exact fromAP_hits hp ha _ _ _ (Nat.succ_pos _) (by assumption)
  · exact fromAP_hits hp ha _ _ _ (by decide) (by change 2 < n; omega)

private def maskColor (n mask x : Nat) := mask.testBit (min x (n-1-x))

private lemma ofMask {n k : Nat} (mask : Nat) (hk : 2 ≤ k)
    (test : ∀ (b : Bool) (a d : Fin n), 0 < d.val → a.val+(terms k b-1)*d.val < n →
      ∃ t : Fin (terms k b), maskColor n mask (a.val+t.val*d.val) = b) : Good n k := by
  refine ⟨maskColor n mask, ?_, ?_⟩
  · intro x hx
    simp only [maskColor, show n-1-(n-1-x) = x by omega, Nat.min_comm (n-1-x) x]
  · intro b a d hd he
    have hl : 1 ≤ terms k b - 1 := by cases b <;> simp [terms] <;> omega
    have hm : d ≤ (terms k b - 1)*d := by simpa using Nat.mul_le_mul_right d hl
    obtain ⟨t, ht⟩ := test b ⟨a, by omega⟩ ⟨d, by omega⟩ hd he
    exact ⟨t.val, t.isLt, ht⟩

/-- Removing equally many points from both ends preserves a symmetric avoiding coloring. -/
theorem restrictGood {n k : Nat} (m s : Nat) (hs : m+2*s=n) (h : Good n k) : Good m k := by
  obtain ⟨c, hp, ha⟩ := h
  refine ⟨fun x => c (x+s), ?_, ?_⟩
  · intro x hx
    change c (m-1-x+s) = c (x+s)
    rw [show m-1-x+s = n-1-(x+s) by omega]
    apply hp
    omega
  · intro b a d hd he
    obtain ⟨t, ht, hcol⟩ := ha b (a+s) d hd (by omega)
    exact ⟨t, ht, by simpa only [Nat.add_right_comm a (t*d) s] using hcol⟩


-- A postfix stream builds each tree on a stack. The low 14 bits specify
-- a branch position (below 128) or a conflict rule (offset by 128). Each
-- remaining digit names a forced rule, followed by a high sentinel bit.
private def decode (stack : List Tree) (word : Nat) : List Tree :=
  let tag := word % 16384
  let digits := word / 16384
  let count := digits.log2 / 13
  if tag < 128 then
    match stack with
    | blue :: red :: tail => .fork count digits tag red blue :: tail
    | _ => []
  else .stop count digits (tag-128) :: stack

private def treeOf (stream : Array Nat) : Tree :=
  (stream.foldl decode []).headD (.stop 0 0 0)

private def cut (word : Nat) (red blue : Tree) : Tree :=
  let digits := word / 16384
  .fork (digits.log2 / 13) digits (word % 16384) red blue
private def positions (red blue : Nat) : Board := fun b => if b then red else blue

private def Refutes (rule : Nat → Rule) (red blue : Nat) : Prop :=
  ∀ c, (∀ i, hits c (rule i)) → agrees c (positions red blue) → False

private theorem checkedPart {rule red blue} (tree : Tree)
    (pass : check rule tree (positions red blue) = true) : Refutes rule red blue :=
  fun _ hr hs => check_sound hr _ _ hs pass

private def reaches (rule : Nat → Rule) (count digits red blue r b : Nat) : Bool :=
  match propagate rule count digits (positions red blue) with
  | none => false
  | some t => (t true == r) && (t false == b)

private theorem joinParts {rule red blue r b} (count digits site : Nat)
    (pass : reaches rule count digits red blue r b = true)
    (l : Refutes rule (r ||| 2^site) b) (rr : Refutes rule r (b ||| 2^site)) :
    Refutes rule red blue := by
  intro c hr hs
  cases e : propagate rule count digits (positions red blue) with
  | none => simp [reaches, e] at pass
  | some t =>
    have vals : t true = r ∧ t false = b := by simpa [reaches, e] using pass
    have teq : t = positions r b := by
      funext col
      cases col
      · exact vals.2
      · exact vals.1
    have ht := propagate_sound hr count digits (positions red blue) t hs e
    rw [teq] at ht
    cases hc : c site with
    | false =>
      apply rr c hr
      have eq : marked (positions r b) false site = positions r (b ||| 2^site) := by
        funext v
        cases v <;> rfl
      exact eq ▸ agrees_marked ht hc
    | true =>
      apply l c hr
      have eq : marked (positions r b) true site = positions (r ||| 2^site) b := by
        funext v
        cases v <;> rfl
      exact eq ▸ agrees_marked ht hc
-- Check only progressions that fit. The independent intervals of common
-- differences keep each kernel computation small.
private def allRange (p : Nat → Bool) (a : Nat) : Nat → Bool
  | 0 => true
  | k+1 => p (a+k) && allRange p a k

private def Covers (p : Nat → Bool) (a z : Nat) : Prop :=
  ∀ i, a ≤ i → i < z → p i = true

private theorem checkedRange {p} (a k : Nat) (test : allRange p a k = true) :
    Covers p a (a+k) := by
  induction k with
  | zero => intro i hlo hhi; omega
  | succ k ih =>
    obtain ⟨last, rest⟩ := Bool.and_eq_true_iff.mp test
    intro i hlo hhi
    by_cases e : i = a+k
    · simpa only [e] using last
    · exact ih rest i hlo (by omega)

private theorem mergeRanges {p a b z} (l : Covers p a b) (r : Covers p b z) :
    Covers p a z := by
  intro i hlo hhi
  rcases lt_or_ge i b with h | h
  · exact l i hlo h
  · exact r i h hhi

private def hasColor (p : Nat → Bool) : Nat → Bool
  | 0 => false
  | k+1 => p k || hasColor p k

private theorem colorExists {p} (k : Nat) (h : hasColor p k = true) :
    ∃ i < k, p i = true := by
  induction k with
  | zero => contradiction
  | succ k ih =>
    rcases Bool.or_eq_true_iff.mp h with last | rest
    · exact ⟨k, Nat.lt_succ_self _, last⟩
    · obtain ⟨i, hi, yes⟩ := ih rest
      exact ⟨i, Nat.lt_succ_of_lt hi, yes⟩

private def checkColor (n k mask : Nat) (b : Bool) (d : Nat) : Bool :=
  allRange (fun a => hasColor (fun t => maskColor n mask (a+t*d) == b) (terms k b))
    0 (n - (terms k b-1)*d)

private def checkDifference (n k mask d : Nat) : Bool :=
  checkColor n k mask false d && checkColor n k mask true d

private theorem witnessOfChecks (n k mask : Nat) (hk : 2 ≤ k)
    (pass : Covers (checkDifference n k mask) 1 n) : Good n k := by
  apply ofMask mask hk
  intro b a d hd he
  have both := Bool.and_eq_true_iff.mp (pass d.val hd d.isLt)
  have good : checkColor n k mask b d.val = true := by
    cases b
    · exact both.1
    · exact both.2
  have valid := checkedRange 0 (n-(terms k b-1)*d.val) good a.val (Nat.zero_le _) (by omega)
  obtain ⟨t, ht, hc⟩ := colorExists _ valid
  exact ⟨⟨t, ht⟩, beq_iff_eq.mp hc⟩

