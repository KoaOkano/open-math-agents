/-- Table 6 of Ahmed, Kullmann and Snevily. With odd length the last
avoiding palindrome has 173 positions, and with even length it has 182. -/
theorem palindromic_3_14 (n : Nat) :
    Good n 14 ↔ (n % 2 = 0 ∧ n ≤ 182) ∨ (n % 2 = 1 ∧ n ≤ 173) := by
  constructor
  · intro h
    by_cases even : n % 2 = 0
    · left
      refine ⟨even, ?_⟩
      by_contra! large
      exact no184 (restrictGood 184 ((n-184)/2) (by omega) h)
    · right
      refine ⟨by omega, ?_⟩
      by_contra! large
      exact no175 (restrictGood 175 ((n-175)/2) (by omega) h)
  · rintro (⟨even, small⟩ | ⟨odd, small⟩)
    · exact restrictGood n ((182-n)/2) (by omega) yes182
    · exact restrictGood n ((173-n)/2) (by omega) yes173

private lemma mono_of_noGood {n : Nat} (h : ¬ Good n 14) (c : Nat → Bool) (hp : Pal n c) :
    ∃ (b : Bool) (a d : Nat), 0 < d ∧ a + (if b then 2 else 13)*d < n ∧
      ∀ t ≤ (if b then 2 else 13), c (a+t*d) = b := by
  classical
  by_contra bad
  apply h
  refine ⟨c, hp, ?_⟩
  intro b a d hd he
  by_contra! absent
  apply bad
  cases b
  · refine ⟨true, a, d, hd, he, ?_⟩
    intro t ht
    exact Bool.ne_false_iff.mp (absent t (by change t < 3; change t ≤ 2 at ht; omega))
  · refine ⟨false, a, d, hd, he, ?_⟩
    intro t ht
    exact Bool.eq_false_iff.mpr (absent t (by change t < 14; change t ≤ 13 at ht; omega))

end PalindromicThreeFourteen

theorem OMA.solution : OMA.R_Green14_W_3_14_R2.H1 := by
  intro n hn c hp
  apply PalindromicThreeFourteen.mono_of_noGood _ c hp
  intro h
  have := (PalindromicThreeFourteen.palindromic_3_14 n).mp h
  rcases hn with rfl | rfl <;> omega
