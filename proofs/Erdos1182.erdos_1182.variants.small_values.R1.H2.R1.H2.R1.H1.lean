import OMAReductions.R_Erdos1182_erdos_1182_variants_small_values_R1_H2_R1_H2_R1

/-!
# The upper edge count for eight-vertex triangle-good graphs

Brandt, Brinkmann and Harmuth, Table 2, give 20 as the maximum number of
edges. The two specified triangle-free hosts in the registry reduction
give a short check. Choose 21 edges of any alleged common graph. The
first host permits 11, 14 or 17 four-cliques in such a selection. The
second host excludes all three values.
-/

-- Formalization: @KoaOkano. The two host masks are from @physbuzz's reduction (PR 8675).

open Finset SimpleGraph

namespace RamseyEight

private def pairs {V : Type*} [DecidableEq V] (S : Finset V) :=
  S.sym2.filter (fun e => ¬ e.IsDiag)

private def four {V : Type*} [DecidableEq V] (S : Finset V) (E : Finset (Sym2 V)) :=
  ((S.powersetCard 4).filter (fun Q => pairs Q ⊆ E)).card

private lemma pairs_map {V W : Type*} [DecidableEq V] [DecidableEq W]
    (f : V ↪ W) (Q : Finset V) : pairs (Q.map f) = (pairs Q).map f.sym2Map := by
  rw [pairs, Finset.sym2_map, Finset.filter_map]
  congr 1
  ext e
  simp only [pairs, mem_filter, Function.comp_apply]
  change (_ ∧ ¬(e.map f).IsDiag) ↔ (_ ∧ ¬e.IsDiag)
  rw [Sym2.isDiag_map f.injective]

private lemma four_map {V W : Type*} [DecidableEq V] [DecidableEq W]
    (f : V ↪ W) (S : Finset V) (E : Finset (Sym2 V)) :
    four (S.map f) (E.map f.sym2Map) = four S E := by
  simp only [four, powersetCard_map, filter_map, card_map]
  congr 1
  apply filter_congr
  intro Q _
  change pairs (Q.map f) ⊆ E.map f.sym2Map ↔ pairs Q ⊆ E
  rw [pairs_map, map_subset_map]

private def board (mask : Nat) : SimpleGraph (Fin 15) where
  Adj i j := i ≠ j ∧ mask.testBit ((min i j).val*15+(max i j).val) = false
  symm := ⟨fun i j h => ⟨h.1.symm, by simpa only [min_comm j i, max_comm j i] using h.2⟩⟩
  loopless := ⟨by simp⟩

private instance (mask : Nat) : DecidableRel (board mask).Adj := fun i j =>
  inferInstanceAs (Decidable (i ≠ j ∧ _ = false))

private def allowed (mask : Nat) (S : Finset (Fin 15)) :=
  S.sym2.filter (fun e => e ∈ (board mask).edgeSet)

private def number (e : Sym2 (Fin 15)) : Nat :=
  Sym2.lift ⟨fun i j => (min i j).val*15+(max i j).val,
    fun i j => by simp only [min_comm i j, max_comm i j]⟩ e

private lemma number_inj : Function.Injective number := by
  intro x y eqn
  induction x using Sym2.ind with
  | _ a b =>
    induction y using Sym2.ind with
    | _ c d =>
      change (min a b).val*15+(max a b).val = (min c d).val*15+(max c d).val at eqn
      rw [Sym2.eq_iff]
      rcases le_total a b with hab|hab <;> rcases le_total c d with hcd|hcd <;>
        simp [hab, hcd] at eqn <;>
        first | left; constructor <;> apply Fin.ext <;> omega
              | right; constructor <;> apply Fin.ext <;> omega

private def bits (E : Finset (Sym2 (Fin 15))) : Nat :=
  E.fold (· ||| ·) 0 (fun e => 2 ^ number e)

private lemma bits_spec (E : Finset (Sym2 (Fin 15))) (i : Nat) :
    (bits E).testBit i = true ↔ ∃ e ∈ E, number e = i := by
  induction E using Finset.induction_on with
  | empty => simp [bits]
  | @insert x S hx ih =>
    rw [show bits (insert x S) = 2^(number x) ||| bits S by simp [bits, hx]]
    simp only [Nat.testBit_or, Nat.testBit_two_pow, Bool.or_eq_true, decide_eq_true_eq, ih,
      mem_insert]
    grind

private lemma bit_at (E : Finset (Sym2 (Fin 15))) (e : Sym2 (Fin 15)) :
    (bits E).testBit (number e) = true ↔ e ∈ E := by
  rw [bits_spec]
  constructor
  · rintro ⟨x, hx, he⟩
    simpa only [number_inj he] using hx
  · exact fun h => ⟨e, h, rfl⟩

private lemma bits_disjoint (F Q : Finset (Sym2 (Fin 15))) :
    (bits F &&& bits Q = 0) ↔ Disjoint F Q := by
  rw [Finset.disjoint_left]
  constructor
  · intro h e hf hq
    have hv := congrArg (fun z : Nat => z.testBit (number e)) h
    simp [Nat.testBit_and, (bit_at F e).mpr hf, (bit_at Q e).mpr hq] at hv
  · intro h
    apply Nat.eq_of_testBit_eq
    intro i
    rw [Nat.testBit_and, Nat.zero_testBit]
    cases hf : (bits F).testBit i <;> simp only [Bool.false_and, Bool.true_and]
    by_contra! hq
    obtain ⟨x,hx,ex⟩ := (bits_spec F i).mp hf
    obtain ⟨y,hy,ey⟩ := (bits_spec Q i).mp (Bool.ne_false_iff.mp hq)
    exact h hx (number_inj (ex.trans ey.symm) ▸ hy)

private def surviving (cliques : Finset (Finset (Fin 15))) (F : Finset (Sym2 (Fin 15))) : Nat :=
  let masks := cliques.val.map (fun Q => bits (pairs Q))
  let erased := bits F
  (masks.filter (fun q => erased &&& q = 0)).card

private lemma surviving_eq (C : Finset (Finset (Fin 15))) (F : Finset (Sym2 (Fin 15))) :
    surviving C F = (C.filter (fun Q => Disjoint F (pairs Q))).card := by
  simp only [surviving, Multiset.filter_map, Multiset.card_map, Finset.card_def, Finset.filter_val]
  congr 1
  apply Multiset.filter_congr
  intro Q _
  exact bits_disjoint F (pairs Q)

private def window (P : Nat → Bool) (mask : Nat) (S : Finset (Fin 15)) : Bool :=
  let A := allowed mask S
  if 21 ≤ A.card then
    let cliques := (S.powersetCard 4).filter (fun Q => pairs Q ⊆ A)
    decide (((A.powersetCard (A.card-21)).filter (fun F =>
      P (surviving cliques F) = false)) = ∅)
  else true

private lemma window_sound {P mask S} (good : window P mask S = true)
    {E : Finset (Sym2 (Fin 15))} (hE : E ⊆ allowed mask S) (hc : E.card = 21) :
    P (four S E) = true := by
  let A := allowed mask S
  have hA : 21 ≤ A.card := hc ▸ Finset.card_le_card hE
  simp only [window, show 21 ≤ (allowed mask S).card from hA, if_true, decide_eq_true_eq] at good
  simp only [surviving_eq] at good
  let F := A \ E
  have hF : F ∈ A.powersetCard (A.card-21) :=
    mem_powersetCard.mpr ⟨sdiff_subset, by rw [Finset.card_sdiff_of_subset hE, hc]⟩
  have same : (((S.powersetCard 4).filter (fun Q => pairs Q ⊆ A)).filter
      (fun Q => Disjoint F (pairs Q))) = (S.powersetCard 4).filter (fun Q => pairs Q ⊆ E) := by
    ext Q
    simp only [mem_filter, Finset.disjoint_left, F, mem_sdiff]
    grind
  cases hv : P (four S E) with
  | true => rfl
  | false =>
    have bad : F ∈ (A.powersetCard (A.card-21)).filter (fun F =>
        P ((((S.powersetCard 4).filter (fun Q => pairs Q ⊆ A)).filter
          (fun Q => Disjoint F (pairs Q))).card) = false) :=
      mem_filter.mpr ⟨hF, by simpa only [same, four] using hv⟩
    rw [good] at bad
    exact False.elim (Finset.notMem_empty _ bad)

private def firstMask : Nat := 822777387642256703234551838076830900798754331299012273175546532
private def secondMask : Nat := 822764833055638660808762661315316885505752648441781026290401700
private def counts (t : Nat) : Bool := t == 11 || t == 14 || t == 17

/- The predicate on a vertex set is invariant under every adjacency-preserving
   permutation of the host. The certificate moves each set toward one of the
   representatives on which we count the four-cliques directly. -/
private def BoundOn (m : Nat) (P : Nat → Bool) (S : Finset (Fin 15)) : Prop :=
  ∀ E ⊆ allowed m S, E.card = 21 → P (four S E) = true

private def vertexBits (S : Finset (Fin 15)) : Nat :=
  S.fold (· ||| ·) 0 (fun x => 2 ^ x.val)

private lemma vertex_insert {i : Fin 15} {S : Finset (Fin 15)} (h : i ∉ S) :
    vertexBits (insert i S) = 2^i.val ||| vertexBits S := by simp [vertexBits, h]

private lemma vertexBit (S : Finset (Fin 15)) (v : Fin 15) :
    (vertexBits S).testBit v.val = true ↔ v ∈ S := by
  induction S using Finset.induction_on with
  | empty => simp [vertexBits]
  | @insert i S hi ih =>
    rw [vertex_insert hi, Nat.testBit_or, Nat.testBit_two_pow]
    simp only [Bool.or_eq_true, decide_eq_true_eq, ih, Finset.mem_insert]
    constructor
    · rintro (h | h)
      · exact Or.inl (Fin.ext h.symm)
      · exact Or.inr h
    · rintro (h | h)
      · exact Or.inl (congrArg Fin.val h.symm)
      · exact Or.inr h

private lemma vertex_inj : Function.Injective vertexBits := by
  intro S T he
  ext i
  rw [← vertexBit, ← vertexBit, he]

private structure Shift where
  mask : Nat
  up : Nat
  down : Nat

private def spread : List Shift → Nat → Nat
  | [], _ => 0
  | s::ss, x => ((((x &&& s.mask) <<< s.up) >>> s.down) ||| spread ss x)

private lemma spread_zero (s : List Shift) : spread s 0 = 0 := by
  induction s <;> simp [spread, *]

private lemma spread_or (s : List Shift) (x y : Nat) :
    spread s (x ||| y) = spread s x ||| spread s y := by
  induction s with
  | nil => simp [spread]
  | cons i is ih =>
    simp only [spread, Nat.and_or_distrib_right, Nat.shiftLeft_or_distrib,
      Nat.shiftRight_or_distrib, ih]
    ac_rfl

private structure Move (m : Nat) where
  emb : Fin 15 ↪ Fin 15
  edges : ∀ i j, (board m).Adj i j → (board m).Adj (emb i) (emb j)
  shifts : List Shift
  atoms : ∀ i : Fin 15, spread shifts (2^i.val) = 2^(emb i).val

private def identityMove (m : Nat) : Move m :=
  ⟨Function.Embedding.refl _, fun _ _ h => h, [⟨32767,0,0⟩], by decide +kernel⟩

private lemma move_bits {m} (g : Move m) (S : Finset (Fin 15)) :
    vertexBits (S.map g.emb) = spread g.shifts (vertexBits S) := by
  induction S using Finset.induction_on with
  | empty => simp [vertexBits, spread_zero]
  | @insert i S hi ih =>
    rw [Finset.map_insert, vertex_insert (by simpa using hi), vertex_insert hi,
      spread_or, g.atoms, ih]

private theorem transport {m P S} (g : Move m) (h : BoundOn m P (S.map g.emb)) :
    BoundOn m P S := by
  intro E he hc
  have subset : E.map g.emb.sym2Map ⊆ allowed m (S.map g.emb) := by
    intro y hy
    obtain ⟨z, hz, rfl⟩ := Finset.mem_map.mp hy
    obtain ⟨hs, ha⟩ := Finset.mem_filter.mp (he hz)
    refine Finset.mem_filter.mpr ⟨?_, ?_⟩
    · rw [Finset.sym2_map]
      exact Finset.mem_map_of_mem _ hs
    · induction z using Sym2.ind with
      | _ i j => exact g.edges i j ha
  simpa only [four_map] using h _ subset (by simpa using hc)

private structure Seed (m : Nat) (P : Nat → Bool) where
  vertices : Finset (Fin 15)
  verified : BoundOn m P vertices

private def seed {m P} (S : Finset (Fin 15)) (h : window P m S = true) : Seed m P :=
  ⟨S, fun _ he hc => window_sound h he hc⟩

private def emptySeed (m P) : Seed m P :=
  ⟨∅, by
    intro E he hc
    have eq : E = ∅ := by simpa [allowed] using he
    simp [eq] at hc⟩

-- Each packed word holds 256 routing entries. A positive low digit names a move.
-- Its high digits are distance to a seed. A zero low digit names a seed
-- directly by its high digits.
private abbrev Table := Array (Array Nat)

private def entry (table : Table) (x : Nat) : Nat :=
  let page := table[x / 4096]?.getD #[]
  (page[(x / 256) % 16]?.getD 0 >>> (16 * (x % 256))) % 65536

private def distance (w : Nat) := if w % 16 = 0 then 0 else w / 16

private def guide {m P} (roots : Array (Seed m P)) (moves : Array (Move m))
    (table : Table) (x : Nat) : Bool :=
  let w := entry table x
  if w % 16 = 0 then decide (x = vertexBits (roots[w/16]?.getD (emptySeed m P)).vertices)
  else
    let g := moves[w%16-1]?.getD (identityMove m)
    decide (distance (entry table (spread g.shifts x)) < distance w)

private theorem guide_sound {m P} (roots : Array (Seed m P)) (moves : Array (Move m))
    (table : Table) (pass : ∀ S : Finset (Fin 15), S.card = 8 →
      guide roots moves table (vertexBits S) = true) (S : Finset (Fin 15)) (hs : S.card = 8) :
    BoundOn m P S := by
  generalize h : distance (entry table (vertexBits S)) = d
  induction d using Nat.strong_induction_on generalizing S with
  | h d ih =>
    have ok := pass S hs
    unfold guide at ok
    dsimp only at ok
    split at ok
    · exact (vertex_inj (of_decide_eq_true ok)) ▸
        (roots[(entry table (vertexBits S))/16]?.getD (emptySeed m P)).verified
    · let g := moves[(entry table (vertexBits S))%16-1]?.getD (identityMove m)
      apply transport g
      apply ih (distance (entry table (vertexBits (S.map g.emb))))
      · rw [move_bits]
        exact h ▸ of_decide_eq_true ok
      · simpa using hs
      · rfl

-- Enumerate subsets of a given size by deciding whether to include the
-- next vertex. Each subtree can be verified as a separate kernel computation.
private def scan (f : Nat → Bool) (base : Nat) :
    List (Fin 15) → Nat → Bool
  | _, 0 => f base
  | [], _+1 => true
  | i::is, k+1 => scan f (base ||| 2^i.val) is k && scan f base is (k+1)

private lemma scan_sound {f} (base : Nat) (xs : List (Fin 15))
    (T : Finset (Fin 15)) (hT : T ⊆ xs.toFinset)
    (ok : scan f base xs T.card = true) : f (base ||| vertexBits T) = true := by
  induction xs generalizing base T with
  | nil =>
    have e : T = ∅ := by simpa using hT
    simpa [e, scan, vertexBits] using ok
  | cons i is ih =>
    by_cases em : T = ∅
    · simpa [em, scan, vertexBits] using ok
    have hp := Finset.card_pos.mpr (Finset.nonempty_iff_ne_empty.mpr em)
    obtain ⟨k, hk⟩ := Nat.exists_eq_succ_of_ne_zero (Nat.ne_of_gt hp)
    rw [hk] at ok
    obtain ⟨take, skip⟩ := Bool.and_eq_true_iff.mp ok
    by_cases hi : i ∈ T
    · have sub : T.erase i ⊆ is.toFinset := by
        intro j hj
        have h := hT (Finset.mem_of_mem_erase hj)
        simpa [Finset.ne_of_mem_erase hj] using h
      have hc : (T.erase i).card = k := by rw [Finset.card_erase_of_mem hi, hk]; rfl
      have got := ih (base ||| 2^i.val) (T.erase i) sub (hc.symm ▸ take)
      have eq : vertexBits T = 2^i.val ||| vertexBits (T.erase i) := by
        simpa only [Finset.insert_erase hi] using vertex_insert (Finset.notMem_erase i T)
      simpa only [eq, Nat.or_assoc] using got
    · have sub : T ⊆ is.toFinset := by
        intro j hj
        have ne : j ≠ i := fun eq => hi (eq ▸ hj)
        simpa [ne] using hT hj
      exact ih base T sub (hk ▸ skip)

private lemma scan_node {f base} {i : Fin 15} {is k}
    (a : scan f (base ||| 2^i.val) is k = true) (b : scan f base is (k+1) = true) :
    scan f base (i::is) (k+1) = true := Bool.and_eq_true_iff.mpr ⟨a,b⟩

private lemma fromPlacement (m : Nat) (P : Nat → Bool)
    (cert : ∀ S : Finset (Fin 15), S.card = 8 → BoundOn m P S)
    {D : SimpleGraph (Fin 8)} [DecidableRel D.Adj] (f : Fin 8 ↪ Fin 15)
    (maps : ∀ i j, D.Adj i j → (board m).Adj (f i) (f j))
    (E : Finset (Sym2 (Fin 8))) (hE : E ⊆ D.edgeFinset) (hc : E.card = 21) :
    P (four univ E) = true := by
  let S := (univ : Finset (Fin 8)).map f
  have hs : S ∈ (univ : Finset (Fin 15)).powersetCard 8 := by simp [S]
  have inc : E.map f.sym2Map ⊆ allowed m S := by
    intro e he
    obtain ⟨z, hz, rfl⟩ := mem_map.mp he
    refine mem_filter.mpr ⟨?_, ?_⟩
    · change f.sym2Map z ∈ (univ.map f).sym2
      rw [sym2_map]
      exact mem_map_of_mem _ (by simp)
    · induction z using Sym2.ind with
      | _ x y => exact maps x y (SimpleGraph.mem_edgeFinset.mp (hE hz))
  have pass := cert S (Finset.mem_powersetCard.mp hs).2 _ inc (by simpa using hc)
  simpa only [S, four_map] using pass

private theorem bound
    (first : ∀ S : Finset (Fin 15), S.card = 8 → BoundOn firstMask counts S)
    (second : ∀ S : Finset (Fin 15), S.card = 8 → BoundOn secondMask (fun t => !counts t) S) :
    OMA.R_Erdos1182_erdos_1182_variants_small_values_R1_H2_R1_H2_R1.H1 := by
  classical
  let masks := (![firstMask, secondMask] : Fin 2 → Nat)
  let C (a : Fin 2) : SimpleGraph (Fin 15) :=
    { Adj := fun i j => i ≠ j ∧ (masks a).testBit ((min i j).val*15+(max i j).val) = true
      symm := ⟨fun i j v => ⟨v.1.symm, by simpa only [min_comm j i, max_comm j i] using v.2⟩⟩
      loopless := ⟨by simp⟩ }
  intro f
  let D := ⨅ a, (C a)ᶜ.comap (f a)
  change D.Connected → D.edgeSet.ncard ≤ 20
  intro _
  by_contra! large
  have card : D.edgeSet.ncard = D.edgeFinset.card := by
    rw [Set.ncard_eq_toFinset_card D.edgeSet]
    congr 1
    ext z
    simp [SimpleGraph.edgeFinset]
  obtain ⟨E, he, hc⟩ := Finset.exists_subset_card_eq (show 21 ≤ D.edgeFinset.card by omega)
  have maps (a : Fin 2) (x y : Fin 8) (h : D.Adj x y) :
      (board (masks a)).Adj (f a x) (f a y) := by
    have adj := (iInf_le (fun a => (C a)ᶜ.comap (f a)) a : D ≤ _) h
    change f a x ≠ f a y ∧ ¬ (_ ∧ _ = true) at adj
    exact ⟨adj.1, Bool.eq_false_iff.mpr (fun hb => adj.2 ⟨adj.1, hb⟩)⟩
  have left := fromPlacement firstMask counts first (f 0) (maps 0) E he hc
  have right := fromPlacement secondMask (fun t => !counts t) second (f 1) (maps 1) E he hc
  simp [left] at right

