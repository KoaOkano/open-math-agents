private theorem on_set (S : Finset (Fin 15)) (hs : S.card = 8) :
    BoundOn secondMask (fun t => !counts t) S := by
  apply guide_sound roots moves table _ S hs
  intro T ht
  have cover : v0.toFinset = univ := by decide +kernel
  have sub : T ⊆ v0.toFinset := by simp [cover]
  have h := scan_sound (f := f) 0 v0 T sub (ht.symm ▸ bAll)
  simpa [f] using h
end Second

